# ProofPath Backend Environment Configuration Template
# Copy this file to .env and customize values for your local environment

PORT=5000
NODE_ENV=development

# Database URIs
MONGODB_URI=mongodb://127.0.0.1:27017/proofpath
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/proofpath_test

# Authentication Security (Minimum 32 characters in production)
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters

# Optional AI Engine Configuration (Gemini Live Mode)
# GEMINI_API_KEY=your_google_gemini_api_key_here
